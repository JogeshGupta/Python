import tkinter as tk
import math

root = tk.Tk()
root.title("Four Bar Mechanism")

canvas = tk.Canvas(root, width=600, height=450)
canvas.pack()

# Given points
A = (150, 300)
D = (400, 300)

L2 = 120
L3 = 150
L4 = 130

theta = math.radians(30)

# Calculate B
B = (
    A[0] + L2 * math.cos(theta),
    A[1] - L2 * math.sin(theta)
)

# Circle centers B and D
x1, y1 = B
x2, y2 = D

r1 = L3
r2 = L4

dx = x2 - x1
dy = y2 - y1

distance = math.sqrt(dx*dx + dy*dy)

a = (r1*r1 - r2*r2 + distance*distance) / (2*distance)

h = math.sqrt(r1*r1 - a*a)

xm = x1 + a*dx/distance
ym = y1 + a*dy/distance

# Two possible circle intersections
C1 = (
    xm + h*dy/distance,
    ym - h*dx/distance
)

C2 = (
    xm - h*dy/distance,
    ym + h*dx/distance
)

# Choose the upper intersection
C = C1 if C1[1] < C2[1] else C2

# Draw links
canvas.create_line(A, B, fill="red", width=4)
canvas.create_line(B, C, fill="blue", width=4)
canvas.create_line(C, D, fill="green", width=4)
canvas.create_line(A, D, fill="black", width=4)

# Draw joints
for point in [A, B, C, D]:
    x, y = point
    canvas.create_oval(
        x-6, y-6, x+6, y+6,
        fill="black"
    )

# Display coordinates
print("A:", A)
print("B:", B)
print("C:", C)
print("D:", D)

root.mainloop()